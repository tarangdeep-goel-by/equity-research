<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Quarterly sector-KPI backfill from concall transcripts (BFSI/FMCG/telecom/
  pharma cohort). Drives ensure_concall_data() per symbol with a sector hint;
  the extraction it writes is the read path for get_sector_kpis(). Runs on the
  concall-refresh cadence — 1st of Mar/Jun/Sep/Dec at 10:00, a few days after
  quarterly-filings (25th of Feb/May/Aug/Nov) has pulled fresh transcripts.
  Incremental: cached quarters are skipped, so re-runs are cheap.

  This is a template: __HOME__ is substituted with $HOME by
  scripts/install-launch-agents.sh at install time. Do not copy this file
  to ~/Library/LaunchAgents/ directly — run the install script instead.

  Install:
      bash scripts/install-launch-agents.sh

  Verify:
      launchctl list | grep flowtracker.quarterly-sector-kpis

  Uninstall:
      launchctl unload ~/Library/LaunchAgents/com.flowtracker.quarterly-sector-kpis.plist
      rm ~/Library/LaunchAgents/com.flowtracker.quarterly-sector-kpis.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.flowtracker.quarterly-sector-kpis</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__HOME__/.local/share/flowtracker/scripts/quarterly-sector-kpis.sh</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__HOME__/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Month</key><integer>3</integer><key>Day</key><integer>1</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Month</key><integer>6</integer><key>Day</key><integer>1</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Month</key><integer>9</integer><key>Day</key><integer>1</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Month</key><integer>12</integer><key>Day</key><integer>1</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
    </array>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__HOME__/.local/share/flowtracker/cron.log</string>

    <key>StandardErrorPath</key>
    <string>__HOME__/.local/share/flowtracker/cron.log</string>
</dict>
</plist>
