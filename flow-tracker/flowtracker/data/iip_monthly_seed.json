  "_meta": {
    "description": "India IIP (Index of Industrial Production) General monthly time series. Each row carries the index level and YoY% growth as published by MoSPI on the 12th of two months later. Used by the macro agent as a real-time manufacturing-activity proxy alongside PMI Manufacturing.",
    "source_authority": "MoSPI monthly IIP press release (mospi.gov.in/iip). Mirrored by FRED INDPROINDMISMEI (OECD-sourced, monthly index level back to 1994; base 2015=100). MoSPI native PDFs use 2011-12=100; YoY% is invariant.",
    "format_notes": [
      "period is the DATA month in YYYY-MM, not the release month. Apr 2025 IIP is released ~12 Jun 2025.",
      "iip_index is on the FRED 2015=100 base; YoY% is invariant to base.",
      "Headline YoY% is the number tracked by the macro agent for the manufacturing-activity signal."
    ],
    "last_updated": "2026-05-26",
    "row_count_target": "Backfill from 2014-01 to 2025-04 (latest at seed creation)."
  },
