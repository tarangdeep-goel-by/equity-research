  "_meta": {
    "description": "India S&P Global Services PMI + Manufacturing PMI monthly time series. Each row carries both headline indices for the same data month. Above 50 = expansion, below 50 = contraction. Used by the macro agent as a real-time leading indicator of economic activity (PMI leads GDP by ~3 months).",
    "source_authority": "S&P Global press releases on the 1st-2nd (Manufacturing) and 3rd-5th (Services) of each month. URL pattern: https://www.pmi.spglobal.com/Public/Home/PressRelease (no clean API; values are extracted from the press release PDFs). This seed is the bundled fallback; live re-fetch is supported via `pmi fetch --source-url` when a specific S&P Global URL is supplied.",
    "format_notes": [
      "period is the DATA month in YYYY-MM. April 2025 PMI is released 1-5 May 2025.",
      "services_pmi and manufacturing_pmi are independent indices but share the same data month.",
      "PMI > 50 = expansion vs prior month, < 50 = contraction. Trend (3-month average) matters more than single-month reading."
    ],
    "last_updated": "2026-05-26",
    "row_count_target": "Backfill from 2014-01 to 2025-04 (~136 months, covers two full business cycles)."
  },
